rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return signedIn()
        ? get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data
        : {};
    }

    function myTokoId() {
      return signedIn() ? myUser().tokoId : null;
    }

    // Dipakai saat bootstrap registrasi karena dokumen pengguna dibuat
    // dalam atomic batch yang sama dengan dokumen toko/pengaturan.
    function myUserAfter() {
      return signedIn()
        ? getAfter(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data
        : {};
    }

    function isAdminFor(tokoId) {
      return signedIn()
        && myUser().role == 'admin'
        && myTokoId() == tokoId;
    }

    function isAdminForAfter(tokoId) {
      return signedIn()
        && myUserAfter().role == 'admin'
        && myUserAfter().tokoId == tokoId;
    }

    function isCustomerFor(tokoId) {
      return signedIn()
        && myUser().role != 'admin'
        && myUser().status == 'aktif'
        && myTokoId() == tokoId;
    }

    // Customer identity is global in V4; store ownership is supplied by Store Context.
    function isActiveCustomer() {
      return signedIn()
        && myUser().role != 'admin'
        && myUser().status == 'aktif';
    }

    function paymentTransitionAllowed(currentStatus, nextStatus) {
      return currentStatus == nextStatus
        || (currentStatus == 'menunggu_konfirmasi' && nextStatus == 'menunggu_verifikasi')
        || (currentStatus == 'menunggu_verifikasi' && nextStatus in ['menunggu_konfirmasi', 'lunas', 'ditolak'])
        || (currentStatus == 'ditolak' && nextStatus == 'menunggu_verifikasi');
    }

    match /pengguna/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Bootstrap registrasi admin: tokoId dikunci sama dengan UID sehingga
      // browser tidak dapat memilih toko milik pihak lain. Setelah dibuat,
      // profil tidak boleh diubah oleh client.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.tokoId == uid
        && request.resource.data.status == 'aktif';
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.role != 'admin'
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'telepon', 'alamat', 'updatedAt']);
      allow delete: if false;
    }

    match /toko/{tokoId} {
      allow read: if isAdminFor(tokoId) || isCustomerFor(tokoId);
      allow create: if signedIn()
        && request.auth.uid == tokoId
        && myUserAfter().role == 'admin'
        && myUserAfter().tokoId == tokoId
        && request.resource.data.pemilikUid == request.auth.uid;
      allow update: if isAdminFor(tokoId)
        && resource.data.pemilikUid == request.auth.uid
        && request.resource.data.pemilikUid == resource.data.pemilikUid;
      allow delete: if isAdminFor(tokoId) && resource.data.pemilikUid == request.auth.uid;

      match /identitas/{docId} {
        // Identitas utama dipakai Gateway/Preview sebagai data storefront publik.
        // Dokumen identitas lain tetap privat.
        allow read: if docId == 'utama' || isAdminFor(tokoId) || isCustomerFor(tokoId);
        allow create: if (isAdminFor(tokoId) || isAdminForAfter(tokoId))
          && request.resource.data.keys().hasOnly(['namaToko', 'logo', 'alamat', 'telepon', 'updatedAt', 'updatedBy']);
        allow update: if isAdminFor(tokoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'namaToko', 'logo', 'alamat', 'telepon', 'updatedAt', 'updatedBy'
          ]);
        allow delete: if isAdminFor(tokoId);
      }

      match /pengaturan/{docId} {
        // Hanya pengaturan beranda yang boleh dibaca publik.
        // Payment tetap privat dan hanya admin yang boleh membacanya.
        allow read: if (docId == 'beranda') || isAdminFor(tokoId) || isCustomerFor(tokoId);
        allow create: if (isAdminFor(tokoId) || isAdminForAfter(tokoId))
          && ((docId == 'pembayaran' && request.resource.data.keys().hasOnly(['bank', 'nomor', 'atasNama', 'updatedAt', 'updatedBy']))
            || (docId == 'beranda' && request.resource.data.keys().hasOnly(['tampilkanStok', 'tampilkanIdeMasak', 'tampilkanProdukTerlaris', 'jumlahProduk', 'tema', 'infoToko', 'updatedAt', 'updatedBy'])));
        allow update: if isAdminFor(tokoId)
          && ((docId == 'pembayaran' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bank', 'nomor', 'atasNama', 'updatedAt', 'updatedBy']))
            || (docId == 'beranda' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tampilkanStok', 'tampilkanIdeMasak', 'tampilkanProdukTerlaris', 'jumlahProduk', 'tema', 'infoToko', 'updatedAt', 'updatedBy'])));
        allow delete: if isAdminFor(tokoId);
      }

      match /kategori/{kategoriId} {
        // Query publik wajib dibatasi ke kategori aktif di client/service.
        allow read: if (resource.data.aktif == true) || isAdminFor(tokoId) || isCustomerFor(tokoId);
        allow create: if (isAdminFor(tokoId) || isAdminForAfter(tokoId))
          && request.resource.data.keys().hasOnly(['nama', 'ikon', 'urutan', 'aktif', 'createdAt', 'updatedAt', 'updatedBy']);
        allow update: if isAdminFor(tokoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nama', 'ikon', 'urutan', 'aktif', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdminFor(tokoId);
      }

      match /produk/{produkId} {
        // Query publik wajib memakai where('aktif', '==', true).
        allow read: if (resource.data.aktif == true) || isAdminFor(tokoId) || isCustomerFor(tokoId);
        allow create: if (isAdminFor(tokoId) || isAdminForAfter(tokoId))
          && request.resource.data.keys().hasOnly(['nama', 'harga', 'hargaJual', 'stok', 'satuan', 'kategoriId', 'foto', 'deskripsi', 'aktif', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'stokTerakhirBerubah', 'stokSumber']);
        allow update: if isAdminFor(tokoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nama', 'harga', 'hargaJual', 'stok', 'satuan', 'kategoriId', 'foto', 'deskripsi', 'aktif',
            'updatedAt', 'updatedBy', 'stokTerakhirBerubah', 'stokSumber'
          ])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAdminFor(tokoId);
      }

      match /pesanan/{orderId} {
        // Admin boleh melihat/mengelola seluruh pesanan tokonya.
        allow read: if isAdminFor(tokoId)
          || (isActiveCustomer() && resource.data.uidPelanggan == request.auth.uid);

        // Pembuatan order pelanggan dilakukan oleh trusted backend/callable function.
        // Client tidak boleh membuat dokumen order secara langsung.
        allow create: if false;

        // Admin dapat mengubah hanya field operasional pesanan yang memang
        // dipakai modul admin. Data inti order (pelanggan, items, harga, total,
        // tokoId, metode pembayaran, sumber) tidak boleh diubah lewat client.
        allow update: if (
            isAdminFor(tokoId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'updatedAt',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'stokDikurangi',
              'stokDikurangiAt',
              'stokDikurangiBy',
              'stokDikembalikan',
              'stokDikembalikanAt',
              'stokDikembalikanBy',
              'statusPembayaran',
              'pembayaran'
            ])
            && (
              !('statusPembayaran' in request.resource.data.diff(resource.data).affectedKeys())
              || (
                resource.data.metodePembayaran == 'transfer'
                && request.resource.data.metodePembayaran == 'transfer'
                && request.resource.data.statusPembayaran in ['menunggu_konfirmasi', 'menunggu_verifikasi', 'lunas', 'ditolak']
                && paymentTransitionAllowed(
                  resource.data.statusPembayaran,
                  request.resource.data.statusPembayaran
                )
                && request.resource.data.pembayaran.status == request.resource.data.statusPembayaran
                && request.resource.data.pembayaran.dikonfirmasiPelanggan == resource.data.pembayaran.dikonfirmasiPelanggan
                && request.resource.data.pembayaran.diff(resource.data.pembayaran).affectedKeys().hasOnly(['status', 'diverifikasiOleh', 'diverifikasiAt'])
              )
            )
          )
          || (
            isActiveCustomer()
            && resource.data.uidPelanggan == request.auth.uid
            && resource.data.metodePembayaran == 'transfer'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['statusPembayaran', 'pembayaran', 'updatedAt'])
            && request.resource.data.status == resource.data.status
            && request.resource.data.items == resource.data.items
            && request.resource.data.total == resource.data.total
            && request.resource.data.metodePembayaran == 'transfer'
            && resource.data.statusPembayaran == 'menunggu_konfirmasi'
            && request.resource.data.statusPembayaran == 'menunggu_verifikasi'
            && request.resource.data.pembayaran.status == 'menunggu_verifikasi'
            && request.resource.data.pembayaran.dikonfirmasiPelanggan == true
            && request.resource.data.pembayaran.diff(resource.data.pembayaran).affectedKeys().hasOnly(['status', 'dikonfirmasiPelanggan'])
          );

        allow delete: if isAdminFor(tokoId);
      }

      // Chat Rumpi: ruang komunitas per toko. Customer aktif dapat membaca/mengirim;
      // admin pemilik toko dapat memoderasi dengan menghapus pesan.
      match /chatRumpi/{messageId} {
        allow read: if isActiveCustomer() || isAdminFor(tokoId);
        allow create: if isActiveCustomer()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == 'pelanggan'
          && request.resource.data.tokoId == tokoId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if isAdminFor(tokoId);
        allow delete: if isAdminFor(tokoId);
      }

      match /chatPelanggan/{chatId} {
        allow read: if isAdminFor(tokoId)
          || (isActiveCustomer() && chatId == request.auth.uid);

        allow create: if isActiveCustomer()
          && chatId == request.auth.uid
          && request.resource.data.uidPelanggan == request.auth.uid
          && request.resource.data.tokoId == tokoId;

        allow update: if (
            isAdminFor(tokoId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lastMessage', 'lastSender', 'updatedAt', 'unreadByAdmin', 'unreadByCustomer'
            ])
            && request.resource.data.tokoId == resource.data.tokoId
            && request.resource.data.uidPelanggan == resource.data.uidPelanggan
          )
          || (
            isActiveCustomer()
            && chatId == request.auth.uid
            && request.resource.data.uidPelanggan == resource.data.uidPelanggan
            && request.resource.data.uidPelanggan == request.auth.uid
            && request.resource.data.tokoId == resource.data.tokoId
            && request.resource.data.tokoId == tokoId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastMessage', 'lastSender', 'unreadByAdmin', 'updatedAt', 'status'])
            && request.resource.data.lastSender == 'pelanggan'
            && request.resource.data.status == 'aktif'
          );

        allow delete: if isAdminFor(tokoId);

        match /messages/{messageId} {
          allow read: if isAdminFor(tokoId)
            || (isActiveCustomer() && chatId == request.auth.uid);

          allow create: if (
              isAdminFor(tokoId)
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == 'admin'
              && request.resource.data.tokoId == tokoId
            )
            || (
              isActiveCustomer()
              && chatId == request.auth.uid
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == 'pelanggan'
              && request.resource.data.tokoId == tokoId
            );

          allow update, delete: if false;
        }
      }
    }
  }
}
